
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Votre Facture</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #333;
            margin: 20px;
        }
        .container {
            width: 100%;
            max-width: 600px;
            margin: auto;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 10px;
            background-color: #f9f9f9;
        }
        h1 {
            text-align: center;
            color: rgb(255, 91, 91);
        }
        .info {
            margin-bottom: 20px;
        }
        .info p {
            margin: 5px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        table, th, td {
            border: 1px solid #ddd;
        }
        th, td {
            padding: 8px;
            text-align: left;
        }
        th {
            background-color:rgb(255, 91, 91);
            color: white;
        }
        .total {
            font-weight: bold;
            text-align: right;
        }
        .footer {
            margin-top: 20px;
            text-align: center;
            font-size: 12px;
            color: #666;
        }
    </style>
</head>
<body>


    <div class="container">
    <center><img src="{{ asset('build/images/logo.webp') }}" alt="Logo du site web NAILBUS" style="width: 10rem;"></center>
        <h1>Merci pour votre achat !</h1>

        <div class="info">
            <p><strong>Client :</strong> {{ user.firstName }}</p>
            <p><strong>Date :</strong> {{ payment.paidAt|date('d/m/Y') }}</p>
            <p><strong>Référence :</strong> {{ payment.stripeSessionId }}</p>
            <p><strong>Commande n° :</strong> {{ order.id }}</p>
        </div>

        <h3>Détails de votre commande :</h3>
        <table>
            <thead>
                <tr>
                    <th>Article</th>
                    <th>Quantité</th>
                    <th>Prix Unitaire</th>
                    <th>Sous-total</th>
                </tr>
            </thead>
            <tbody>
                {% set total = 0 %}
                {% for item in payment.paymentDetails %}
                    <tr>
                        <td>{{ item.product ? item.product.name : item.name}}</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.price|number_format(2, ',', ' ') }} €</td>
                        <td>{{ (item.quantity * item.price)|number_format(2, ',', ' ') }} €</td>
                    </tr>
                    {% set total = total + (item.quantity * item.price) %}
                {% endfor %}
                <tr>
                    <td colspan="3" class="total">Total :</td>
                    <td>{{ total|number_format(2, ',', ' ') }} €</td>
                </tr>
            </tbody>
        </table>

        <p>Votre facture est attachée en pièce jointe.</p>
        <a class="btn:hover btn" href="{{ path('app_home') }}"> Revenir au site </a>

        

        {# Footer de secours en cas d'absence de footer HTML #}
        <div class="footer">
            <p>NAILBUS - SIRET : 000 000 000 00000 - example@email.com</p>
            <p>Merci pour votre confiance !</p>
        </div>
    </div>


</body>
</html>