{% extends 'base.html.twig' %}

{% block title %}Catalogue - Ecommerce{% endblock %}

{% block body %}
<div>
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
    <section id="products" class="mt-5">
        <h1 class="mb-4">Catalogue</h1>

        <!-- Barre de recherche -->
        <form method="GET" action="{{ path('app_catalog') }}" class="d-flex form-inline mb-4">
            <input class="form-control mr-sm-2" type="search" name="q" placeholder="Rechercher un produit" aria-label="Search" size="50" value="{{ query ?? '' }}">
            <button class="btn btn-outline-dark my-2 my-sm-0" type="submit">Rechercher</button>
        </form>

        {% if query is defined and query is not empty %}
            <p>Résultats pour : <strong>{{ query }}</strong></p>
        {% endif %}

        <div>
            <label for="maxPriceInput">Prix maximum :</label>
            <input type="number" id="maxPriceInput" min="0" step="1" placeholder="Ex : 100" />
            <button id="filterPriceBtn" class="btn btn-outline-dark">Filtrer par prix</button>
        </div>

        <!-- Conteneur pour la liste des produits -->
        <div id="productList">
            {% include 'catalog/_product_list.html.twig' with { pagination: pagination } %}
        </div>
        


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $('#filterPriceBtn').on('click', function () {
        const maxPrice = $('#maxPriceInput').val();

        $.ajax({
            url: '{{ path('app_catalog_filter_price') }}',
            type: 'GET',
            data: { max_price: maxPrice },
            success: function(response) {
                $('#productList').html(response.html);
            },
            error: function() {
                alert('Erreur lors du chargement des produits.');
            }
        });
    });
</script>

</div>
{% endblock %}

