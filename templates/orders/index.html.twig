{% extends 'base.html.twig' %}

{% block title %}Hello OrdersController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
{% if app.user %}
<main class="col-md-6 mb-3">
                <h2>Commandes</h2>

            {% if orders is empty %}
                <p>Vous n'avez aucune commande passée ou en cours.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Date</th>
                                <th>Prix</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                                <tr>
                                    <td>{{ order.invoice }}</td>
                                    <td>{{ order.date|date('d/m/Y H:i') }}</td>
                                    <td>{{ order.price }} €</td>
                                    <td>{{ order.status }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </main>
{% else %}
    <div class="mb-3">
                Vous devez avoir un compte et être connecté pour voir vos commandes.<a class="dropdown-item" href="/login"><button class="btn btn-outline-dark ml-2">Connexion/Inscription</button></a>
            </div>
{% endif %}

{% endblock %}
